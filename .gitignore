# Tells GitHub Pages NOT to run Jekyll over this repo — serve our static
# files as-is. Without this, Jekyll regenerates the index from README.md and
# the site no longer shows the real app.
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ============================================================
# Scraper runtime / secrets (never commit)
# ============================================================
# Anonymized test artifacts
*_out.txt
_push.txt
_hc.txt

# ============================================================
# OS / editor junk
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============================================================
# Large / redundant build artifacts
# ============================================================
restaurant-website-gh-pages.zip